#!/bin/bash
# macOS Dev Audit Tool
# A professional, modular, stack-agnostic macOS developer diagnostics CLI tool
#
# Usage: ./mac-dev-audit [OPTIONS]
# Run with --help for more information

set -eo pipefail

# Get the directory where this script is located (resolving symlinks)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source core libraries
source "$SCRIPT_DIR/lib/core.sh"
source "$SCRIPT_DIR/lib/config.sh"
source "$SCRIPT_DIR/lib/output.sh"
source "$SCRIPT_DIR/lib/args.sh"
source "$SCRIPT_DIR/lib/cleanup.sh"

# Run cleanup mode
run_cleanup() {
    echo ""
    echo "${COLOR_CYAN}${COLOR_BOLD}+==================================================================+${COLOR_RESET}"
    echo "${COLOR_CYAN}${COLOR_BOLD}|              macOS Dev Audit Tool - Cleanup Mode                |${COLOR_RESET}"
    echo "${COLOR_CYAN}${COLOR_BOLD}+==================================================================+${COLOR_RESET}"
    echo ""

    if [[ "$DRY_RUN" == "true" ]]; then
        echo "${COLOR_YELLOW}[DRY-RUN MODE] No files will be deleted.${COLOR_RESET}"
        echo ""
    fi

    echo "Scanning for development bloat (threshold: ${THRESHOLD_GB} GB)..."
    echo ""

    local threshold_bytes
    threshold_bytes=$(gb_to_bytes "$THRESHOLD_GB")

    # Source config to get bloat patterns
    local patterns
    patterns=$(get_bloat_patterns "$SCRIPT_DIR")

    if [[ -z "$patterns" ]]; then
        echo "${COLOR_RED}Error: No bloat patterns file found.${COLOR_RESET}"
        return 1
    fi

    # Reset cleanup state
    cleanup_reset

    # Process each pattern
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue

        local pattern category explanation
        pattern=$(parse_bloat_pattern "$line" 1)
        category=$(parse_bloat_pattern "$line" 2)
        explanation=$(parse_bloat_pattern "$line" 3)

        [[ -z "$pattern" ]] && continue

        # Search for pattern in home directory
        while IFS= read -r found_path; do
            if [[ -d "$found_path" ]]; then
                # Check if safe to delete
                if ! is_safe_to_delete "$found_path"; then
                    continue
                fi

                local size_kb
                size_kb=$(du -sk "$found_path" 2>/dev/null | cut -f1)

                if [[ -n "$size_kb" ]]; then
                    local size_bytes=$((size_kb * 1024))

                    # Only include items above 50MB
                    if [[ "$size_bytes" -gt 52428800 ]]; then
                        cleanup_add_item "$found_path" "$size_bytes" "$category"
                    fi
                fi
            fi
        done < <(find "$HOME" -maxdepth 5 -type d -name "$pattern" 2>/dev/null)
    done <<< "$patterns"

    # Also check common cache directories
    local cache_dirs=(
        "$HOME/Library/Caches/com.apple.dt.Xcode"
        "$HOME/Library/Developer/Xcode/DerivedData"
        "$HOME/Library/Developer/Xcode/Archives"
        "$HOME/Library/Developer/Xcode/iOS DeviceSupport"
        "$HOME/Library/Caches/CocoaPods"
        "$HOME/Library/Caches/org.swift.swiftpm"
        "$HOME/Library/Caches/Homebrew"
        "$HOME/.gradle/caches"
        "$HOME/.npm/_cacache"
        "$HOME/.cache/pip"
    )

    for cache_dir in "${cache_dirs[@]}"; do
        if [[ -d "$cache_dir" ]]; then
            local size_kb
            size_kb=$(du -sk "$cache_dir" 2>/dev/null | cut -f1)

            if [[ -n "$size_kb" ]]; then
                local size_bytes=$((size_kb * 1024))

                if [[ "$size_bytes" -gt 52428800 ]]; then
                    cleanup_add_item "$cache_dir" "$size_bytes" "cache"
                fi
            fi
        fi
    done

    # Show preview
    cleanup_show_preview

    if [[ -z "$CLEANUP_ITEMS" ]]; then
        return 0
    fi

    # Confirm and execute
    if cleanup_confirm "Are you sure you want to delete these items?"; then
        cleanup_execute
    fi
}

# Run all modules and collect output
run_audit() {
    # Initialize output
    output_init

    # Print header
    output_header

    # Load and run modules
    local modules_run=0

    for module_file in "$SCRIPT_DIR/modules/"*.sh; do
        if [[ -f "$module_file" ]]; then
            local module_name
            module_name=$(basename "$module_file" .sh)

            # Check if module should run
            if should_run_module "$module_name"; then
                log_debug "Running module: $module_name"

                # Source the module
                source "$module_file"

                # Run the module
                local run_func="module_${module_name}_run"
                if declare -f "$run_func" > /dev/null; then
                    if ! "$run_func"; then
                        log_warn "Module '$module_name' completed with warnings"
                    fi
                    modules_run=$((modules_run + 1))
                else
                    log_warn "Module '$module_name' does not have a run function"
                fi
            fi
        fi
    done

    if [[ $modules_run -eq 0 ]]; then
        die "No modules were run. Check your --modules selection."
    fi

    # Print footer or JSON output
    if [[ "$OUTPUT_FORMAT" == "json" ]]; then
        output_json_final
    else
        output_footer
    fi
}

# Main function
main() {
    # Check we're on macOS
    check_macos
    check_macos_version "12.0"

    # Load configuration (layered)
    load_config "$SCRIPT_DIR"

    # Parse command line arguments (overrides config)
    parse_args "$@"

    # Validate module selection
    validate_modules

    # If clean mode, run cleanup instead of audit
    if [[ "$CLEAN_MODE" == "true" ]]; then
        run_cleanup
        exit $?
    fi

    # If report file specified, capture output
    if [[ -n "$REPORT_FILE" ]]; then
        local output
        output=$(run_audit 2>&1)

        # Print to stdout
        echo "$output"

        # Strip ANSI colors for file output
        local clean_output
        clean_output=$(echo "$output" | sed 's/\x1b\[[0-9;]*m//g')

        output_to_report "$REPORT_FILE" "$clean_output"
    else
        # Run normally
        run_audit
    fi
}

# Run main function
main "$@"
